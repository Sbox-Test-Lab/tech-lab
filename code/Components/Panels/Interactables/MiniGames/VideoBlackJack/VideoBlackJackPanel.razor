@using Sandbox;
@using Sandbox.UI;
@using Sandbox.Razor;
@using System;

@inherits PanelComponent

@namespace ItemBuilder.UI


<root>
    <div class="blackjack-panel">
        <div class="main-panel">
            <div class="title">Black Jack</div>

            <div class="info-panel">
                <div class="chips-label">Chips: @Machine.PlayerChips</div>
                <div class="bet-label">Current Bet: @Machine.CurrentBet</div>
            </div>

            <div class="cards-panel">
                
                <div class="dealer-panel">

                    <div class="dealer-title">Dealer</div>
                    <div class="dealer-cards">
                        <div class="cards-display">
                            @foreach (var card in Machine.DealerHand.Cards)
                            {
                                @if (card.IsHidden)
                                {
                                    <div class="playing-card card-hidden">
                                        <div class="card-back">
                                            <div class="card-back-symbol">🂠</div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="playing-card @GetCardSuitClass(card)">
                                        <div class="card-corner top-left">
                                            <div class="card-rank">@card.GetRankName()</div>
                                            <div class="card-suit">@card.GetSuitSymbol()</div>
                                        </div>

                                        <div class="card-center">
                                            <div class="card-center-suit">
                                                @card.GetSuitSymbol()
                                            </div>
                                        </div>

                                        <div class="card-corner bottom-right">
                                            <div class="card-rank">@card.GetRankName()</div>
                                            <div class="card-suit">@card.GetSuitSymbol()</div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                    
                    
                    
                    
 
                </div>

                <div class="player-panel">

                    <div class="dealer-title">Player</div>

                    <div class="player-cards">
                        <div class="cards-display">
                            @foreach (var card in Machine.PlayerHand.Cards)
                            {
                                @if (card.IsHidden)
                                {
                                    <div class="playing-card card-hidden">
                                        <div class="card-back">
                                            <div class="card-back-symbol">🂠</div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="playing-card @GetCardSuitClass(card)">
                                        <div class="card-corner top-left">
                                            <div class="card-rank">@card.GetRankName()</div>
                                            <div class="card-suit">@card.GetSuitSymbol()</div>
                                        </div>

                                        <div class="card-center">
                                            <div class="card-center-suit">
                                                @card.GetSuitSymbol()
                                            </div>
                                        </div>

                                        <div class="card-corner bottom-right">
                                            <div class="card-rank">@card.GetRankName()</div>
                                            <div class="card-suit">@card.GetSuitSymbol()</div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <div class="player-value">@Machine.PlayerHand.GetValue()</div>

                </div>
            </div>

            <div class="status-panel">
                <div class="status-label">@Machine.GetStatusText()</div>
            </div>

            <div class="game-panel">
                <button class="game-button bet-button" onclick=@OnBetButtonPressed>Bet</button>`
                <button class="game-button stand-button" onclick=@OnStandButtonPressed>Stand</button>
                <button class="game-button hit-button" onclick=@OnHitButtonPressed>Hit</button>
                <button class="game-button deal-button" onclick=@OnDealButtonPressed>Deal</button>
            </div>
        </div>
    </div>
</root>

@code {
    [Property] public VideoBlackJack Machine { get; set; }

    private void OnBetButtonPressed()
    {
        Machine.PlaceBet(10);
    }

    private void OnDealButtonPressed()
    {
        Machine.DealCards();
    }

    private void OnHitButtonPressed()
    {
        Machine.Hit();
    }

    private void OnStandButtonPressed()
    {
        Machine.Stand();
    }

    private string GetCardSuitClass(Card card)
    {
        string suitClass = card.CardSuit switch
        {
            Card.Suit.Spades => "card-spades",
            Card.Suit.Diamonds => "card-diamonds",
            Card.Suit.Hearts => "card-hearts",
            Card.Suit.Clubs => "card-clubs",
            _ => ""
        };
       
        return suitClass;
    }

    private string GetHiddenClass(Card card)
    {
        return card.IsHidden ? "card-hidden" : "";
    }
}

