@using Sandbox;
@using Sandbox.UI;
@using Sandbox.Razor;
@using System;

@inherits Panel

@namespace ItemBuilder.UI

<style>
    InventorySlot {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-end;
        width: 100%;
        height: 100%;
        background-color: rgba( 255, 255, 255, 0.05 );
        border: 2px solid rgba( 255, 255, 255, 0.1 );
        border-radius: 4px;
        padding: 4px;
        gap: 2px;
        transition: background-color 0.1s, border-color 0.1s;
        z-index: 1001;
        &:hover {
            background-color: rgba( 255, 255, 255, 0.12 );
            border-color: rgba( 255, 255, 255, 0.25 );
        }

        &.selected {
            border-color: #4fc3f7;
            background-color: rgba( 79, 195, 247, 0.15 );
        }

        .slot-icon {
            flex-grow: 1;
            width: 100%;
            background-size: contain;
            background-repeat: no-repeat;
            background-position: center;
        }

        .slot-icon--placeholder {
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: rgba( 255, 255, 255, 0.08 );
            border-radius: 2px;

            label {
                font-size: 24px;
                color: rgba( 255, 255, 255, 0.4 );
                font-weight: bold;
            }
        }

        .slot-name {
            font-size: 10px;
            color: rgba( 255, 255, 255, 0.7 );
            text-align: center;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            width: 100%;
        }
    }
</style>

<root class="@(IsSelected ? "selected" : "")">
    @if ( Resource is not null )
    {
        @if ( Resource.GetThumbnail() is Texture thumb )
        {
            <div class="slot-icon" style="background-image: url(@thumb.ResourcePath);"></div>
        }
        else
        {
            <div class="slot-icon slot-icon--placeholder">
                <label>@(Resource.Name?.Substring( 0, 1 ) ?? "?")</label>
            </div>
        }
        <label class="slot-name">@Resource.Name</label>
    }
    else
    {
        <div class="slot-icon slot-icon--placeholder">
            <label>?</label>
        </div>
        <label class="slot-name">@State?.ResourcePath</label>
    }
</root>

@code
{
    /// <summary>Slot index in the inventory.</summary>
    [Parameter] public int Index { get; set; }

    /// <summary>Deserialized state snapshot for this slot.</summary>
    [Parameter] public ItemState State { get; set; }

    /// <summary>The item resource for this slot, used to display icon and name.</summary>
    [Parameter] public ItemResource Resource { get; set; }

    /// <summary>Whether this slot is the currently equipped index.</summary>
    [Parameter] public bool IsSelected { get; set; }

    protected override int BuildHash()
    {
        return HashCode.Combine( Index, State?.ResourcePath, IsSelected );
    }
}
